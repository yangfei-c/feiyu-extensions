{
  "manifest_version": 3,
  "name": "飞羽 · arXiv 论文助手",
  "version": "2.2.3",
  "description": "专用于 arXiv 论文页面的双语对照翻译、结构化导读、划词问答与阅读记录导出工具（需用户自行接入 API Key）",
  "author": "YangFei",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "飞羽 · arXiv 论文助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://arxiv.org/pdf/*",
        "https://ar5iv.labs.arxiv.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
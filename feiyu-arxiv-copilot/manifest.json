{
  "manifest_version": 4,
  "name": "飞羽 · 学术论文助手",
  "version": "4.1.0",
  "description": "支持 arXiv、ScienceDirect 及 PDF 论文页面，提供双语对照翻译、结构化导读、划词问答与阅读记录导出（需用户自行接入 API Key）",
  "author": "YangFei",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "飞羽 · 学术论文助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://arxiv.org/*",
    "https://www.sciencedirect.com/*",
    "https://*.sciencedirectassets.com/*",
    "https://ars.els-cdn.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/abs/*",
        "https://arxiv.org/html/*",
        "https://arxiv.org/pdf/*",
        "https://ar5iv.labs.arxiv.org/*",
        "https://www.sciencedirect.com/science/article/*",
        "https://*.sciencedirectassets.com/*"
      ],
      "js": [
        "src/config/constants.js",
        "src/content/render.js",
        "src/content/extractor.js",
        "src/content/pdf.js",
        "src/content/panel.js",
        "src/content/index.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/panel.css",
        "src/lib/pdf.min.mjs",
        "src/lib/pdf.worker.min.mjs"
      ],
      "matches": [
        "https://arxiv.org/*",
        "https://ar5iv.labs.arxiv.org/*",
        "https://www.sciencedirect.com/*",
        "https://*.sciencedirectassets.com/*"
      ]
    }
  ]
}
